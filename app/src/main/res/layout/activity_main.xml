<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 1. Background Artwork -->

    <!-- 2. Falling Leaves & Floating Petals Particle Layer -->

    <!-- 3. Soft Gradient Fade Overlay to blend seamlessly -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/rdx_video_scrim" />

    <!-- 4. Scrollable Dashboard Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="36dp"
            android:paddingBottom="28dp">

            <!-- Top Header: Logo + Brand + Notification Bell Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent">

                    <ImageView
                        android:id="@+id/ivDashLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/rdx_icon"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RDX LOADER"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RDX ENGINE"
                        android:textColor="#CFD8E8"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnTelegram"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_rdx_glass_icon"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/rdx_icon"
                        android:contentDescription="Telegram" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnAudioToggle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_rdx_glass_icon"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivAudioToggle"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_audio_off"
                        android:contentDescription="Audio toggle" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnNotificationBell"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_rdx_glass_icon"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell"
                        android:contentDescription="Notifications" />
                </FrameLayout>
            </LinearLayout>

            <!-- Card 1: Device Info Card -->
            <LinearLayout
                android:id="@+id/cardDeviceInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rdx_glass"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_rdx_glass_icon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_phone_device"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/tvDeviceModel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="samsung SM-M315F"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDeviceCodename"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(m31)"
                        android:textColor="#CFD8E8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDeviceSpecs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Android 12 - arm64-v8a"
                        android:textColor="#CFD8E8"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pillConnectedStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_rdx_status"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_rdx_online"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvConnectedStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RDX ONLINE"
                        android:textColor="#34D399"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 2: Game Target & Launch Card -->
            <LinearLayout
                android:id="@+id/cardGameTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rdx_glass"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <!-- Top Row: Icon + Game Details + 3-dots Menu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp">

                        <ImageView
                            android:id="@+id/ivGameIcon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/pubg_india"
                            android:scaleType="centerCrop"
                            android:contentDescription="Game Icon" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/tvGameName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Battlegrounds India"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvGamePackage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Package : com.pubg.imobile"
                            android:textColor="#CFD8E8"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tvGameVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Version : 4.7.0"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tvGameSupported"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Supported : 4.7.0"
                            android:textColor="#AFC0D8"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnGameMenu"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_more_vert"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Options" />
                </LinearLayout>

                <!-- Full Width Black START GAME Button -->
                <FrameLayout
                    android:id="@+id/btnLaunchGame"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_rdx_glass_button"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:id="@+id/btnLaunchContent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_gamepad"
                            android:contentDescription="@null"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/tvLaunchLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="START GAME"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="#FFFFFF"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbLaunchProgress"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#FFFFFF"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- Card 2.5: Game Account Card (Twitter, Facebook, More -> Discord & Google) -->
            <LinearLayout
                android:id="@+id/cardSocialAccounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rdx_glass"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Game Account"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvActiveAccountSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Not Linked"
                            android:textColor="#34D399"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAccountHintBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rdx_status"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="1-Click Active"
                        android:textColor="#34D399"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Primary Circular Row: Twitter, Facebook, More -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Twitter / X Circle -->
                    <LinearLayout
                        android:id="@+id/btnAccountTwitter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp">

                            <FrameLayout
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_circle_twitter"
                                android:elevation="3dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_social_twitter"
                                    android:contentDescription="Twitter" />
                            </FrameLayout>

                            <View
                                android:id="@+id/dotTwitterActive"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_active_dot"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Twitter"
                            android:textColor="#E8EEF9"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <!-- Facebook Circle -->
                    <LinearLayout
                        android:id="@+id/btnAccountFacebook"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp">

                            <FrameLayout
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_circle_facebook"
                                android:elevation="3dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_social_facebook"
                                    android:contentDescription="Facebook" />
                            </FrameLayout>

                            <View
                                android:id="@+id/dotFacebookActive"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_active_dot"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Facebook"
                            android:textColor="#E8EEF9"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <!-- More Circle -->
                    <LinearLayout
                        android:id="@+id/btnAccountMore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp">

                            <FrameLayout
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_circle_more"
                                android:elevation="2dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_social_more"
                                    android:contentDescription="More" />
                            </FrameLayout>

                            <View
                                android:id="@+id/dotMoreActive"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_active_dot"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvAccountMoreLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="More"
                            android:textColor="#E8EEF9"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Expandable Secondary Row: Discord & Google -->
                <LinearLayout
                    android:id="@+id/layoutMoreAccounts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="14dp"
                    android:paddingTop="12dp"
                    android:visibility="gone">

                    <!-- Discord Circle -->
                    <LinearLayout
                        android:id="@+id/btnAccountDiscord"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp">

                            <FrameLayout
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_circle_discord"
                                android:elevation="3dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_social_discord"
                                    android:contentDescription="Discord" />
                            </FrameLayout>

                            <View
                                android:id="@+id/dotDiscordActive"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_active_dot"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Discord"
                            android:textColor="#E8EEF9"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <!-- Google Circle -->
                    <LinearLayout
                        android:id="@+id/btnAccountGoogle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp">

                            <FrameLayout
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_circle_google"
                                android:elevation="3dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_social_google"
                                    android:contentDescription="Google" />
                            </FrameLayout>

                            <View
                                android:id="@+id/dotGoogleActive"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_active_dot"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Google"
                            android:textColor="#E8EEF9"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: Hide ESP Card (From Live Demo Video) -->
            <LinearLayout
                android:id="@+id/cardHideEsp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rdx_glass"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_rdx_glass_icon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_hide_esp"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hide ESP"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Can Be Used To Hide Esp From Recording"
                        android:textColor="#CFD8E8"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchHideEsp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:showText="false"
                    android:textOn=""
                    android:textOff="" />
            </LinearLayout>

            <!-- Card 4: Subscription / License Validity Card -->
            <LinearLayout
                android:id="@+id/cardSubscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rdx_glass"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_rdx_glass_icon">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_subscription"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Subscription"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="License validity"
                            android:textColor="#CFD8E8"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 4-Box Countdown Timer Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Box 1: DAYS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rdx_glass"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/tvCountdownDays"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="48"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DAYS"
                            android:textColor="#CFD8E8"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Box 2: HOURS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rdx_glass"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/tvCountdownHours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="09"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HOURS"
                            android:textColor="#CFD8E8"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Box 3: MINUTES -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rdx_glass"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/tvCountdownMinutes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="46"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MINUTES"
                            android:textColor="#CFD8E8"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Box 4: SECONDS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rdx_glass"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvCountdownSeconds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="38"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SECONDS"
                            android:textColor="#CFD8E8"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Pill: Installed Version -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_rdx_glass"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_apple_cube"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvInstalledTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Installed : 0.0.2"
                    android:textColor="#CFD8E8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 5: RDX ACTIVE Card (From Video) -->
            <LinearLayout
                android:id="@+id/cardSdkActivated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rdx_glass"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_rdx_glass_icon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shield_check"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RDX ACTIVE"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RDX Engine"
                        android:textColor="#16A34A"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Footer: Copyright & Version -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Copyright @2026 - RDX LOADER"
                    android:textColor="#CFD8E8"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loader (v0.0.2)"
                    android:textColor="#AFC0D8"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
