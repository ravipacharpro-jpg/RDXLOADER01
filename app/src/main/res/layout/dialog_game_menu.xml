<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dark_frosted_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="28dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#4B5563"
        android:layout_marginBottom="18dp" />

    <!-- Title & Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Game Options"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Battlegrounds Mobile India"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <!-- Option 1: Re-sync Game OBB & Data -->
    <LinearLayout
        android:id="@+id/btnMenuSyncObb"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_dark_menu_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_subscription"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Re-sync Game OBB &amp; Data"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="14dp" />
    </LinearLayout>

    <!-- Option 2: Verify Virtual Container -->
    <LinearLayout
        android:id="@+id/btnMenuVerifyContainer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_dark_menu_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_shield_check"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verify Virtual Container"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="14dp" />
    </LinearLayout>

    <!-- Option: Send Diagnostic Logs -->
    <LinearLayout
        android:id="@+id/btnMenuSendLogs"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_dark_menu_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_phone_device"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send Diagnostic Logs"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="14dp" />
    </LinearLayout>

    <!-- Option 3: Sign Out -->
    <LinearLayout
        android:id="@+id/btnMenuSignOut"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_dark_menu_signout"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign Out"
            android:textColor="#EF4444"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="14dp" />
    </LinearLayout>

</LinearLayout>
