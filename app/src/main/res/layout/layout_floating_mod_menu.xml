<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/modMenuOverlayContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Centered Landscape Frosted Mod Menu Window -->
    <LinearLayout
        android:id="@+id/modMenuCard"
        android:layout_width="660dp"
        android:layout_height="370dp"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/bg_floating_card"
        android:padding="8dp"
        android:clickable="true">

        <!-- 1. LEFT SIDEBAR / TAB RAIL -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- Tab 1: Aim / Combat -->
            <FrameLayout
                android:id="@+id/tabAim"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_tab_active"
                android:clickable="true">
                <!-- Vertical indicator strip -->
                <View
                    android:id="@+id/indicatorAim"
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="#53C8FF" />
                <ImageView
                    android:id="@+id/ivTabAim"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_menu_aim" />
            </FrameLayout>

            <!-- Tab 2: Visuals / ESP -->
            <FrameLayout
                android:id="@+id/tabVisuals"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true">
                <View
                    android:id="@+id/indicatorVisuals"
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="#53C8FF"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/ivTabVisuals"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_eye" />
            </FrameLayout>

            <!-- Tab 3: Weapons -->
            <FrameLayout
                android:id="@+id/tabWeapons"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true">
                <View
                    android:id="@+id/indicatorWeapons"
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="#53C8FF"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/ivTabWeapons"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_menu_weapons" />
            </FrameLayout>

            <!-- Tab 4: Items -->
            <FrameLayout
                android:id="@+id/tabItems"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true">
                <View
                    android:id="@+id/indicatorItems"
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="#53C8FF"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/ivTabItems"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_menu_items" />
            </FrameLayout>

            <!-- Tab 5: Settings -->
            <FrameLayout
                android:id="@+id/tabSettings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true">
                <View
                    android:id="@+id/indicatorSettings"
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="#53C8FF"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/ivTabSettings"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_menu_settings" />
            </FrameLayout>

            <!-- Tab 6: Brand / Info -->
            <FrameLayout
                android:id="@+id/tabBrand"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true">
                <View
                    android:id="@+id/indicatorBrand"
                    android:layout_width="3dp"
                    android:layout_height="18dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="#53C8FF"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/ivTabBrand"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_menu_brand" />
            </FrameLayout>

        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#D1D5DB"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp" />

        <!-- 2. MAIN BODY -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <!-- Left: Avatar + Title -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Small Brand Avatar -->
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/rdx_icon"
                        android:scaleType="centerCrop"
                        android:layout_marginEnd="8dp" />

                    <!-- Brand Name & Elite -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RDX LOADER"
                                android:textColor="#111827"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Elite"
                                android:textColor="#6B7280"
                                android:textSize="16sp"
                                android:textStyle="normal" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RDX ENGINE"
                            android:textColor="#9CA3AF"
                            android:textSize="8sp"
                            android:letterSpacing="0.1" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Right Action Buttons (Theme Toggle, Settings, Close X) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Theme Toggle -->
                    <FrameLayout
                        android:id="@+id/btnThemeToggle"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_menu_item_pill"
                        android:clickable="true"
                        android:layout_marginEnd="6dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_sun" />
                    </FrameLayout>

                    <!-- Settings Button -->
                    <FrameLayout
                        android:id="@+id/btnHeaderSettings"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_menu_item_pill"
                        android:clickable="true"
                        android:layout_marginEnd="6dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_menu_settings" />
                    </FrameLayout>

                    <!-- Close X Button -->
                    <FrameLayout
                        android:id="@+id/btnCloseMenu"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_menu_item_pill"
                        android:clickable="true">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_close_x" />
                    </FrameLayout>

                </LinearLayout>

            </RelativeLayout>

            <!-- Main Content Area: Split 2 Columns -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <!-- Left Column: Scrollable Features List -->
                <ScrollView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/llFeaturesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingEnd="6dp">

                        <!-- Item 1: Player Line -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/bg_menu_item_pill"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <View
                                    android:layout_width="2.5dp"
                                    android:layout_height="14dp"
                                    android:background="#111827"
                                    android:layout_marginEnd="8dp" />
                                <TextView
                                    android:id="@+id/tvLabel1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Player Line"
                                    android:textColor="#111827"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <Switch
                                android:id="@+id/switch1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Item 2: Player Box -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/bg_menu_item_pill"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <View
                                    android:layout_width="2.5dp"
                                    android:layout_height="14dp"
                                    android:background="#111827"
                                    android:layout_marginEnd="8dp" />
                                <TextView
                                    android:id="@+id/tvLabel2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Player Box"
                                    android:textColor="#111827"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <Switch
                                android:id="@+id/switch2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Item 3: Player Health -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/bg_menu_item_pill"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <View
                                    android:layout_width="2.5dp"
                                    android:layout_height="14dp"
                                    android:background="#111827"
                                    android:layout_marginEnd="8dp" />
                                <TextView
                                    android:id="@+id/tvLabel3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Player Health"
                                    android:textColor="#111827"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <Switch
                                android:id="@+id/switch3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Item 4: Player Skeleton -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/bg_menu_item_pill"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <View
                                    android:layout_width="2.5dp"
                                    android:layout_height="14dp"
                                    android:background="#111827"
                                    android:layout_marginEnd="8dp" />
                                <TextView
                                    android:id="@+id/tvLabel4"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Player Skeleton"
                                    android:textColor="#111827"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <Switch
                                android:id="@+id/switch4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Item 5: Player Distance -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/bg_menu_item_pill"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <View
                                    android:layout_width="2.5dp"
                                    android:layout_height="14dp"
                                    android:background="#111827"
                                    android:layout_marginEnd="8dp" />
                                <TextView
                                    android:id="@+id/tvLabel5"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Player Distance"
                                    android:textColor="#111827"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <Switch
                                android:id="@+id/switch5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <!-- Item 6: Enemy Count -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_menu_item_pill"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <View
                                    android:layout_width="2.5dp"
                                    android:layout_height="14dp"
                                    android:background="#111827"
                                    android:layout_marginEnd="8dp" />
                                <TextView
                                    android:id="@+id/tvLabel6"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Enemy Count"
                                    android:textColor="#111827"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <Switch
                                android:id="@+id/switch6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                    </LinearLayout>

                </ScrollView>

                <!-- Right Column: Soldier Banner + Telemetry Controls -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="4dp">

                    <!-- Soldier Banner Card (Matches Screenshot exactly) -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rdx_glass"
                        android:clipToOutline="true">

                        <!-- Soldier Background Image -->

                        <!-- Dark Tint Overlay -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#770D1117" />

                        <!-- Text Overlay -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RDX ENGINE"
                                android:textColor="#DDFFFFFF"
                                android:textSize="8sp"
                                android:letterSpacing="0.12"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="RDX LOADER"
                                android:textColor="#FFFFFF"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="E L I T E"
                                android:textColor="#53C8FF"
                                android:textSize="10sp"
                                android:letterSpacing="0.2"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="32dp"
                                android:layout_height="1dp"
                                android:layout_marginTop="4dp"
                                android:background="#53C8FF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="Stay Ahead"
                                android:textColor="#F3F4F6"
                                android:textSize="15sp"
                                android:textStyle="italic" />

                        </LinearLayout>

                    </FrameLayout>

                    <!-- Bottom Bar: FPS Circle + Ping Button + Pulse Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <!-- FPS Circular Badge -->
                        <LinearLayout
                            android:id="@+id/badgeFps"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_fps_circle"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FPS"
                                android:textColor="#6B7280"
                                android:textSize="7sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvFpsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="120"
                                android:textColor="#111827"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="120Hz"
                                android:textColor="#9CA3AF"
                                android:textSize="7sp" />

                        </LinearLayout>

                        <!-- Globe Ping Button -->
                        <FrameLayout
                            android:id="@+id/btnGlobePing"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_stat_button"
                            android:clickable="true">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_globe" />
                        </FrameLayout>

                        <!-- Pulse Status Button -->
                        <FrameLayout
                            android:id="@+id/btnPulseStatus"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_menu_item_pill"
                            android:clickable="true">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_pulse" />
                        </FrameLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Bottom Subtitle / Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="DISCIPLINE CREATES FREEDOM"
                android:textColor="#9CA3AF"
                android:textSize="7sp"
                android:letterSpacing="0.1" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
